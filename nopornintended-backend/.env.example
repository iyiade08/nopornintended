SECRET_KEY=django-insecure-local-dev-key-change-before-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Supabase Postgres. Leave DATABASE_URL empty/commented for local SQLite.
# Use the Supabase connection string and keep ?sslmode=require on the end.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_CONN_MAX_AGE=0
DATABASE_SSLMODE=require
DATABASE_DISABLE_SERVER_SIDE_CURSORS=True

# Supabase Storage. Keep USE_SUPABASE_STORAGE=False for local media uploads.
USE_SUPABASE_STORAGE=False
SUPABASE_STORAGE_BUCKET=media

# Recommended fallback: Supabase Storage REST API.
SUPABASE_STORAGE_DRIVER=rest
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/media

# Optional: Supabase S3-compatible API.
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION_NAME=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=replace-with-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Optional bulk video migration to Bunny. Keep the existing Supabase settings.
# Copy the storage-zone password from Bunny Storage > your zone > Access.
# This is NOT the global account API key. Never commit the real password.
BUNNY_STORAGE_ZONE=nopornintended-videos
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_URL=https://nopornintendedvideos.b-cdn.net
BUNNY_TRANSFER_TIMEOUT=600
